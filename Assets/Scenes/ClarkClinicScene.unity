  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InfoPointController
  _resetTriggerTimeSeconds: 180
  _infoSign: {fileID: 538768194}
  _movePlayerToInfoPoint: 0
  _playerOrientation: {fileID: 522187056}
  _infoPointHeadingText: Cardiac Physiologist
  _subtitleText: We have a very long name, Cardiac Physiologists. We are a group
    of staff who carry out a range of tests which help the doctor to diagnose and
    monitor your heart condition. These include ECG, ECHO, exercise stress test,
    ambulatory ECG monitoring and pacemaker checks. Sometimes we       come to you
    on the ward to do these tests but usually you come downstairs to see us in our
    room. We have iPads to entertain you so it's great fun. Even when you're not
    in Clark Clinic you may come back to visit us in a department downstairs and
    have all these tests done.
  WaitingForCooldown: 0
